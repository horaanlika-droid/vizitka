# ============================================================
#  VIZITKA — переменные окружения для панели Ботхоста
#
#  ПРАВИЛО: в панель хостинга вводим ТОЛЬКО СЕКРЕТЫ (ниже).
#  Все не-секретные настройки (адрес сайта, контакты, ссылка
#  оплаты, админы, каналы, порты, флаги запуска) зашиты в код —
#  блок SITE_* в начале config.py. Там же менять, если нужно.
#
#  ENV имеет приоритет над кодом: если переменная ниже задана,
#  она переопределит значение из config.py.
# ============================================================

# ---------- Обязательно (без этого бот/веб не запустятся) ----------
BOT_TOKEN=                # токен клиентского бота, у @BotFather
ADMIN_BOT_TOKEN=          # токен отдельного админ-бота
ADMIN_PANEL_TOKEN=        # свой пароль для веб-админки (/admin)

# ---------- Только если используешь оплату через GRAM API ----------
# PAYMENTS_PROVIDER=auto  # auto | gram | manual (auto=по наличию GRAM_API_*)
GRAM_API_KEY=             # ключ твоего GRAM API
GRAM_WEBHOOK_SECRET=      # секрет подписи колбэков от GRAM API

# ============================================================
#  Дальше — НЕ обязательно. Нужно только для локальной разработки
#  у себя на ПК или для переопределения значений из config.py.
# ============================================================

# PUBLIC_URL=https://tvoy-bot.bothost.ru   # уже в config.py (SITE_PUBLIC_URL)
# WEBAPP_URL=                              # по умолчанию = PUBLIC_URL

# ADMIN_IDS=1896036065                     # уже в config.py (SITE_ADMIN_IDS)
# CONTACT_USERNAME=milayaqueen             # уже в config.py
# PAYMENT_LINK=https://yoomoney.ru/to/4100119149767529  # уже в config.py
# CHANNELS=chat_goddes                     # уже в config.py

# GRAM_API_BASE_URL=                       # не секрет, но адрес твоего API
# GRAM_MERCHANT_ID=
# GRAM_WALLET_ADDRESS=
# GRAM_RUB_RATE=                           # курс GRAM->RUB для конвертации цен

# DB_PATH=game.db
# MEDIA_CACHE_DIR=media_cache
# PROMO_SYNC_INTERVAL=30
# LOG_LEVEL=INFO

# --- Режимы запуска (по умолчанию все = 1) ---
# RUN_WEB=1
# RUN_CLIENT_BOT=1
# RUN_ADMIN_BOT=1

# --- ВНИМАНИЕ: только для локального превью! На проде = 0 ---
# ALLOW_DEV_AUTH=1
