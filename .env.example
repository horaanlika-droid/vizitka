# ============================================================
#  VIZITKA — минимальный деплой: TONAPI_KEY + ADMIN_IDS
#  Всё остальное опционально, подхватывается автоматически.
#  Порядок запуска в main.py: config -> db -> payments -> web -> bots
# ============================================================

# ---------- МИНИМАЛЬНЫЙ НАБОР (достаточно этого для старта) ----------
TONAPI_KEY=                  # ключ с https://tonapi.io — у тебя уже есть
ADMIN_IDS=1896036065         # id админов через запятую — узнай через @userinfobot
# Кошелек можно НЕ указывать в ENV — задашь потом через /admin?admin_token=admin_1896036065
TON_WALLET_ADDRESS=          # EQ... или UQ... твой TON кошелек (можно задать позже в /admin)

# ---------- Боты (опционально, если хочешь Telegram ботов) ----------
BOT_TOKEN=                   # основной (клиентский) бот — возьми у @BotFather
ADMIN_BOT_TOKEN=             # отдельный админ-бот (если пусто — используется BOT_TOKEN)

# ---------- Веб (авто-детект для БотХоста, Render, Railway) ----------
PORT=8080                    # порт (БотХост ставит сам)
HOST=0.0.0.0
PUBLIC_URL=                  # внешний https адрес (если пусто — авто-детект из RENDER_EXTERNAL_URL, RAILWAY_PUBLIC_DOMAIN и т.д.)
WEBAPP_URL=                  # адрес Mini App (по умолчанию = PUBLIC_URL)

# ---------- База и файлы ----------
DB_PATH=game.db
MEDIA_CACHE_DIR=media_cache

# ---------- Контакты/контент ----------
CONTACT_USERNAME=milayaqueen
PAYMENT_LINK=https://yoomoney.ru/to/4100119149767529
CHANNELS=chat_goddes

# ---------- Оплата GRAM (твой API) — опционально ----------
PAYMENTS_PROVIDER=auto       # auto | gram | manual | tonapi (auto детектит TONAPI_KEY)
GRAM_API_BASE_URL=
GRAM_API_KEY=
GRAM_MERCHANT_ID=
GRAM_WALLET_ADDRESS=         # = TON_WALLET_ADDRESS
GRAM_WEBHOOK_SECRET=
GRAM_CREATE_PATH=/invoices
GRAM_STATUS_PATH=/invoices/{id}
GRAM_RUB_RATE=

# ---------- TONAPI доп. настройки ----------
TONAPI_BASE_URL=https://tonapi.io
GRAM_JETTON_MASTER=          # опционально: адрес мастера GRAM Jetton
TONAPI_CHECK_INTERVAL=30

# ---------- Веб-админка (авто-генерится если пусто: admin_{ADMIN_IDS}) ----------
ADMIN_PANEL_TOKEN=           # если пусто — генерится как admin_1896036065

# ---------- Режимы запуска ----------
RUN_WEB=1
RUN_CLIENT_BOT=1
RUN_ADMIN_BOT=1

# ---------- Прочее ----------
ALLOW_DEV_AUTH=0
PROMO_SYNC_INTERVAL=30
LOG_LEVEL=INFO
