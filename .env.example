# ============================================================
#  VIZITKA — пример переменных окружения для Ботхоста
#  Скопируй нужное в панель хостинга. Все переменные опциональны:
#  сервис стартует даже с пустыми, недоступные части просто
#  отключаются (см. логи на старте). Порядок запуска и проверки —
#  в main.py: config -> db -> payments -> web -> bots.
# ============================================================

# ---------- Боты ----------
BOT_TOKEN=                   # основной (клиентский) бот
ADMIN_BOT_TOKEN=             # отдельный админ-бот
ADMIN_IDS=1896036065         # id админов через запятую

# ---------- Веб ----------
PORT=8080                    # порт (обычно хостинг выставляет сам)
HOST=0.0.0.0
PUBLIC_URL=https://tvoy-servis.bothost.example   # внешний адрес сервиса
WEBAPP_URL=                  # адрес Mini App (по умолчанию = PUBLIC_URL)

# ---------- База и файлы ----------
DB_PATH=game.db              # путь к sqlite (относительно корня репо)
MEDIA_CACHE_DIR=media_cache  # кэш фото из Telegram

# ---------- Контакты/контент ----------
CONTACT_USERNAME=milayaqueen
PAYMENT_LINK=https://yoomoney.ru/to/4100119149767529
CHANNELS=chat_goddes

# ---------- Оплата GRAM (твой API) ----------
# Достаточно задать GRAM_API_BASE_URL + GRAM_API_KEY — провайдер
# подхватится автоматически (PAYMENTS_PROVIDER=auto).
PAYMENTS_PROVIDER=auto       # auto | gram | manual
GRAM_API_BASE_URL=           # например https://pay-api.example.com
GRAM_API_KEY=
GRAM_MERCHANT_ID=
GRAM_WALLET_ADDRESS=         # твой GRAM-кошелёк (для ручного режима)
GRAM_WEBHOOK_SECRET=         # секрет подписи колбэков от API
GRAM_CREATE_PATH=/invoices
GRAM_STATUS_PATH=/invoices/{id}
GRAM_RUB_RATE=               # курс GRAM->RUB для автоконвертации цен

# ---------- Веб-админка ----------
ADMIN_PANEL_TOKEN=           # пароль-токен для /admin (задай свой!)

# ---------- Режимы запуска ----------
RUN_WEB=1
RUN_CLIENT_BOT=1
RUN_ADMIN_BOT=1

# ---------- Прочее ----------
ALLOW_DEV_AUTH=0             # 1 — тестовый вход в веб без Telegram (только превью!)
PROMO_SYNC_INTERVAL=30
LOG_LEVEL=INFO
