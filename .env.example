# ============================================================
#  VIZITKA — пример переменных окружения для Ботхоста
#  Скопируй нужное в панель хостинга. Все переменные опциональны:
#  сервис стартует даже с пустыми, недоступные части просто
#  отключаются (см. логи на старте). Порядок запуска и проверки —
#  в main.py: config -> db -> payments -> web -> bots.
# ============================================================

# ---------- Боты ----------
BOT_TOKEN=                   # основной (клиентский) бот — возьми у @BotFather
ADMIN_BOT_TOKEN=             # отдельный админ-бот (можно тот же токен, но лучше отдельный)
ADMIN_IDS=1896036065         # id админов через запятую — узнай через @userinfobot

# ---------- Веб ----------
PORT=8080                    # порт (обычно хостинг выставляет сам, на БотХосте не трогай)
HOST=0.0.0.0
PUBLIC_URL=https://tvoy-servis.bothost.example   # внешний https адрес сервиса (ОБЯЗАТЕЛЬНО для БотХоста!)
WEBAPP_URL=                  # адрес Mini App (по умолчанию = PUBLIC_URL, если пусто)

# ---------- База и файлы ----------
DB_PATH=game.db              # путь к sqlite (относительно корня репо)
MEDIA_CACHE_DIR=media_cache  # кэш фото из Telegram

# ---------- Контакты/контент ----------
CONTACT_USERNAME=milayaqueen
PAYMENT_LINK=https://yoomoney.ru/to/4100119149767529
CHANNELS=chat_goddes

# ---------- Оплата GRAM (твой API) ----------
# Достаточно задать GRAM_API_BASE_URL + GRAM_API_KEY — провайдер
# подхватится автоматически (PAYMENTS_PROVIDER=auto).
PAYMENTS_PROVIDER=auto       # auto | gram | manual | tonapi
GRAM_API_BASE_URL=           # например https://pay-api.example.com
GRAM_API_KEY=                # если используешь свой платежный API
GRAM_MERCHANT_ID=
GRAM_WALLET_ADDRESS=         # твой GRAM-кошелёк (для ручного режима) = TON_WALLET_ADDRESS
GRAM_WEBHOOK_SECRET=         # секрет подписи колбэков от API
GRAM_CREATE_PATH=/invoices
GRAM_STATUS_PATH=/invoices/{id}
GRAM_RUB_RATE=               # курс GRAM->RUB для автоконвертации цен

# ---------- Оплата через TONAPI (если у тебя есть TONAPI_KEY) ----------
# Это САМЫЙ ПРОСТОЙ способ для БотХоста: не нужен свой API.
# Задаешь TONAPI_KEY + кошелек — бот сам проверяет блокчейн по мемо.
TONAPI_KEY=                  # ключ с https://tonapi.io — у тебя уже есть
TONAPI_BASE_URL=https://tonapi.io
TON_WALLET_ADDRESS=          # твой TON/GRAM кошелек (EQ... или UQ...), куда принимать оплату
GRAM_JETTON_MASTER=          # опционально: адрес мастера GRAM Jetton, если принимаешь именно GRAM Jetton
TONAPI_CHECK_INTERVAL=30     # как часто проверять pending заказы, сек

# ---------- Веб-админка ----------
ADMIN_PANEL_TOKEN=           # пароль-токен для /admin (задай свой! любой рандомный)

# ---------- Режимы запуска ----------
RUN_WEB=1
RUN_CLIENT_BOT=1
RUN_ADMIN_BOT=1

# ---------- Прочее ----------
ALLOW_DEV_AUTH=0             # 1 — тестовый вход в веб без Telegram (только превью! На проде 0)
PROMO_SYNC_INTERVAL=30
LOG_LEVEL=INFO
