@router.callback_query(F.data.startswith("choice_"))
async def handle_choice(callback: CallbackQuery):
    user_id = callback.from_user.id
    username = callback.from_user.username or f"user_{user_id}"
    
    parts = callback.data.split("_")
    scene_id = "_".join(parts[1:-1])
    choice_idx = int(parts[-1])
    
    scene = scenes.get(scene_id)
    if not scene:
        await callback.message.answer("Ошибка: сцена не найдена")
        return
    
    choices = scene.get("choices", [])
    if choice_idx >= len(choices):
        await callback.message.answer("Ошибка: выбор не найден")
        return
    
    next_scene_id = choices[choice_idx].get("next_scene")
    
    if next_scene_id == "chap5_check":
        channel_ok = await check_channel_subscription(user_id, "chat_goddes")
        if channel_ok:
            await verify_tasks(user_id)
            await callback.message.answer("✅ Задания выполнены!")
            await asyncio.sleep(1)
            next_scene_id = "chap5_scene1"
        else:
            await callback.message.answer("❌ Подпишись на канал @chat_goddes")
            await asyncio.sleep(2)
            next_scene_id = "chap5_tasks"
    
    if next_scene_id == "chap6_ideal":
        await set_ending(user_id, "ideal")
        await add_points(user_id, 50)
        await add_achievement(user_id, "🏆 Идеальный пёс")
