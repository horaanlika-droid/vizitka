@router.message(Command("add_dice"))
async def cmd_add_dice(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        return
    args = message.text.split()
    if len(args) < 3:
        await message.answer("❌ /add_dice @username количество")
        return
    
    username = args[1].replace("@", "").lower()
    try:
        amount = int(args[2])
    except ValueError:
        await message.answer("❌ Количество должно быть числом")
        return
    
    if amount <= 0:
        await message.answer("❌ Количество должно быть больше 0")
        return
    
    async with aiosqlite.connect("game.db") as db:
        async with db.execute("SELECT user_id FROM players WHERE LOWER(username) = ?", (username,)) as cursor:
            row = await cursor.fetchone()
            if not row:
                await message.answer("❌ Пользователь не найден")
                return
            user_id = row[0]
    
    current = await get_rolls_left(user_id)
    await set_rolls_left(user_id, current + amount)
    
    await message.answer(f"✅ {amount} бросков добавлено @{username}\n📦 Всего: {await get_rolls_left(user_id)}")
    
    try:
        await bot.send_message(user_id, f"🎲 Богиня Мила добавила тебе {amount} бросков!\n\nНажми «🎲 КУБИКИ» чтобы играть.")
    except:
        pass

