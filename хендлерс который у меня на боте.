        broadcast_data.pop("waiting_for_adult_code", None)
        
        if target_level == 1:
            await update_adult_level(user_id, 1)
            await message.answer(
                ADULT_TASKS[1],
                reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="🔑 ВВЕСТИ КОД (ПОСЛЕ ВЫПОЛНЕНИЯ)", callback_data="adult_enter_code")]
                ])
            )
        else:
            await add_points(user_id, 10)
            await update_adult_level(user_id, target_level)
            
            if target_level == 6:
                await complete_adult(user_id)
                await add_points(user_id, 50)
                await add_achievement(user_id, "💀 Сломленный")
                await message.answer(
                    "🔞 ПОЗДРАВЛЯЮ! Ты прошёл ТЁМНУЮ КОМНАТУ!\n\n"
                    "💀 Звание: «Сломленный»\n🎁 +50 бонусных баллов!\n\n"
                    "🎁 ТВОЙ ПОДАРОК: СЕССИЯ С БОГИНЕЙ МИЛОЙ!\nНапиши в ЛС @milla_femdomqueen"
                )
            else:
                await message.answer(
                    f"✅ ИСПЫТАНИЕ {target_level - 1} ПРОЙДЕНО!\n\n+10 баллов!\n\n{ADULT_TASKS[target_level]}",
                    reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                        [InlineKeyboardButton(text="🔑 ВВЕСТИ КОД (ПОСЛЕ ВЫПОЛНЕНИЯ)", callback_data="adult_enter_code")]
                    ])
                )
        return

